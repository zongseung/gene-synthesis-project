# ver4 §03.01 · HanMed vLLM serving image.
#
# Base: vLLM 공식 OpenAI-compatible API server (CUDA 12.4 + PyTorch 2.5 + vLLM 0.7.0)
# Model: compose volume mount (./outputs/hanmed_merged_v0.1 → /model)
#
# 빌드:
#   cd docker && docker compose build
# 기동:
#   cd docker && docker compose up -d
# 확인:
#   curl -sf http://localhost:8000/health

FROM vllm/vllm-openai:v0.7.0

LABEL org.opencontainers.image.title="hanmed-llm"
LABEL org.opencontainers.image.version="v0.1"
LABEL org.opencontainers.image.description="HanMed P-A+ CPT adapter (merged) served via vLLM"

WORKDIR /app

# model 은 volume mount — 이미지 내장 X (16 GB · 재사용성)
# tokenizer 는 model 디렉토리에 포함됨 (build_merged_model.py 가 tok.save_pretrained 수행)

HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
  CMD python3 -c "import urllib.request,sys; urllib.request.urlopen('http://localhost:8000/health',timeout=3)" || exit 1

EXPOSE 8000

ENTRYPOINT ["python3", "-m", "vllm.entrypoints.openai.api_server"]
