# ver8.1 § serving · HanMed RAG sidecar.
#
# RAG retrieval (FAISS + BGE-M3) + safety (pre/post check) + vLLM upstream
# call. STRICT mode 만 우선 통합 (INFO mode 는 후속).
#
# 빌드 컨텍스트: experiments/dongui_bogam/  (compose.ver8_1.yml 참조)
# 빌드:
#   docker compose -f compose.ver8_1.yml build hanmed_rag
# 기동:
#   docker compose -f compose.ver8_1.yml up -d hanmed_rag

FROM python:3.12-slim

LABEL org.opencontainers.image.title="hanmed-rag"
LABEL org.opencontainers.image.version="ver8.1"
LABEL org.opencontainers.image.description="HanMed RAG sidecar — retrieval + safety + vLLM client"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/app

WORKDIR /app

# system deps for faiss + sentence-transformers (libgomp 필요)
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgomp1 \
        curl \
    && rm -rf /var/lib/apt/lists/*

# Python deps
COPY rag_service/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# 앱 코드 + 안전 모듈 (hanmed_cli)
COPY rag_service /app/
COPY src/hanmed_cli /app/hanmed_cli/

# BGE-M3 등 sentence-transformers 모델은 HF hub cache 형태 (/hf/hub/models--*/snapshots/...)
# SENTENCE_TRANSFORMERS_HOME 을 설정하면 v2-style cache layout 을 기대해 HF hub cache 와
# 충돌, snapshot resolution 실패. HF_HOME 만 두고 sentence-transformers 가 자동으로
# HF hub cache 를 사용하게 한다.
ENV HF_HOME=/hf

HEALTHCHECK --interval=20s --timeout=4s --start-period=60s --retries=3 \
  CMD curl -sf http://localhost:8080/health || exit 1

EXPOSE 8080

ENTRYPOINT ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1"]
