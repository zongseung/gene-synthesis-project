# ver8.1 § serving · HanMed vLLM serving image.
#
# Base: vLLM 공식 OpenAI-compatible API server.
#   v0.7.0 → v0.10.2 bump 사유:
#   - Gemma3 (Phase B base 모델) 가 v0.7.3 부터 지원, v0.8.x 에서 안정화.
#   - Phase A (Bllossom-8B) 는 이전 0.7.0 이미지로도 작동했지만 ver8.1 부터
#     Gemma3-12B-IT (multimodal: vision_config + text_config) 가 base 라
#     Gemma3 호환 vLLM 필요.
#
# Model: compose volume mount (../outputs_ver8_1_gemma_v1/merged → /model).
#
# 빌드:
#   docker compose -f compose.ver8_1.yml build
# 기동:
#   docker compose -f compose.ver8_1.yml up -d
# 확인:
#   curl -sf http://localhost:8000/health

FROM vllm/vllm-openai:v0.10.2

LABEL org.opencontainers.image.title="hanmed-llm"
LABEL org.opencontainers.image.version="ver8.1"
LABEL org.opencontainers.image.description="HanMed Phase B (Gemma3-12B + ver8.1 LoRA, merged) served via vLLM"

WORKDIR /app

# model 은 volume mount — 이미지 내장 X (~24 GB · 재사용성)
# tokenizer + chat_template 은 merged model 디렉토리에 포함됨
# (build_merged_model_ver8_1.py 가 adapter 의 tokenizer.json + chat_template.jinja 복사)

HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
  CMD python3 -c "import urllib.request,sys; urllib.request.urlopen('http://localhost:8000/health',timeout=3)" || exit 1

EXPOSE 8000

ENTRYPOINT ["python3", "-m", "vllm.entrypoints.openai.api_server"]
